+# ==== [PAPER] ==== PaperData_v1 adapter (all data reads go through paper_eval/paperdata_io) ====
+# Official structure feature (Dataset_yeast_structure.readfile, dataio.py:57-102): energy.fold holds RNAfold MFE of 30-nt
+# windows starting at CDS offsets -13 ... 3L-20 (iXnos processing, 13 nt 5'UTR / 10 nt 3'UTR flank). readfile stores
+# foldsource = [-1]*14 + [MFE(window o) for o = -13..] + [-1]*14 and takes fold = foldsource[13 : 13+3L], i.e.
+#     fold[j] = MFE(RNAfold(seq[j-14 : j+16]))   for windows available, else -1 (official missing marker).
+# PaperData_v1 mfe_raw(tx)[k] = MFE(RNA.fold(seq[k:k+30])) for k < n_valid = 3L-29 (CDS only, no UTR), so
+#     fold[j] = mfe_raw[j-14]  if 0 <= j-14 < n_valid  else -1.
+# Positions j in [1,13] and [3L-15, 3L-6] use UTR-flank windows in the official data; they are -1 here (CDS only).
+FOLD_SHIFT = 14          # official alignment: value at nt j = window starting at j-14
+FOLD_MISSING = -1.0      # official missing marker ([-1]*14 padding in readfile)
+
+
+def paper_fold_track(mfe_raw, n_valid, n_nt):
+    """Official-aligned per-nt MFE track (length n_nt = 3L) from PaperData mfe_raw (window start k)."""
+    fold = np.full(n_nt, FOLD_MISSING, dtype=float)
+    j = np.arange(n_nt); k = j - FOLD_SHIFT
+    ok = (k >= 0) & (k < n_valid)
+    fold[ok] = np.asarray(mfe_raw, float)[k[ok]]
+    return fold
+
+
+def paper_docs(ds, ids, with_counts=True, structure=True):
+    """Return official-format docs for transcripts `ids` of a paperdata_io dataset:
+    codon-string lists, nt-char lists, per-nt fold lists (structure) and per-codon labels (avg_count).
+    with_counts=False never touches ds.counts (used for test-time inference: labels are None)."""
+    docs_c, docs_nt, docs_fold, docs_lab = [], [], [], []
+    for k in ids:
+        seq = ds.seq[k]
+        L = len(seq) // 3
+        docs_c.append([seq[3*i:3*i+3] for i in range(L)])
+        docs_nt.append([x for x in seq])
+        docs_fold.append(list(paper_fold_track(ds.mfe_raw(k), ds.mfe_valid(k), len(seq))) if structure else None)
+        docs_lab.append(list(np.asarray(ds.counts[k], float)) if with_counts else None)
+    return docs_c, docs_nt, docs_fold, docs_lab
+
+
+_VOCAB = Dataset_yeast.__new__(Dataset_yeast); _VOCAB.genVocab()
+CODON_VOCAB, CHAR_VOCAB = _VOCAB.codon_vocab, _VOCAB.char_vocab   # official genVocab (dataio.py:170-181)
+
+
+def to_index(docs, vocab):
+    return [[vocab[x] for x in doc] for doc in docs]   # official word2index without 'unk' (PaperData is pure ACGT; asserted)
